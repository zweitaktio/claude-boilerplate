{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["esnext"],
    "types": ["node"]
  },
  "include": ["*.ts", "core/*.ts", "core/*.d.mts", "../../scripts/*.ts"]
}
