{
  "name": "webstack-hooks",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling for typechecking/linting/formatting webstack hooks. NOT deployed to target projects.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types core/*.test.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  }
}
