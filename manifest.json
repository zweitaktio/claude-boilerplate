{
  "groups": [
    {
      "name": "hooks",
      "src": ".claude/hooks",
      "dest": ".claude/hooks",
      "include": [
        "*.mjs",
        "*.ts"
      ],
      "exclude": [
        ".prettierrc.mjs"
      ],
      "versioning": "comment",
      "chmod": true,
      "_comment": "`find -name '*.mjs'` matches dotfiles, so .prettierrc.mjs was shipping as a hook. It configures this repo's own hook toolchain (see .claude/hooks/package.json, which is NOT deployed), so in a target project it is an orphan no prettier ever reads."
    },
    {
      "name": "hook-infra",
      "src": ".claude/hooks",
      "dest": ".claude/hooks",
      "include": [
        "run.sh",
        "core/*.mjs"
      ],
      "versioning": "checksum",
      "chmod": true
    },
    {
      "name": "agents",
      "src": "agents",
      "dest": ".claude/agents",
      "include": [
        "*.md"
      ],
      "versioning": "checksum",
      "_comment": "Claude Code agent frontmatter is name/description/model/tools \u2014 no version: field, so compare by checksum rather than frontmatter."
    },
    {
      "name": "wiki-scripts",
      "src": "scripts",
      "dest": ".claude/scripts",
      "include": [
        "wiki.sh",
        "wiki-review.ts",
        "ste-check.ts",
        "dupe-check.ts",
        "pitfall-eval.ts"
      ],
      "versioning": "checksum",
      "chmod": true
    },
    {
      "name": "rules",
      "src": "core",
      "dest": ".claude/rules/core",
      "include": [
        "**/*.md"
      ],
      "versioning": "frontmatter",
      "flatten": true,
      "conditional": true
    },
    {
      "name": "vendor",
      "src": "vendor",
      "dest": ".claude/rules/vendor",
      "include": [
        "**/*.md"
      ],
      "versioning": "frontmatter",
      "conditional": true
    },
    {
      "name": "settings",
      "src": ".claude/settings.json",
      "dest": ".claude/settings.json",
      "versioning": "merge",
      "mergeKeys": [
        "hooks"
      ]
    },
    {
      "name": "configs",
      "files": {
        "core/playwright-mcp.config.json": ".claude/playwright-mcp.config.json"
      },
      "versioning": "overwrite"
    },
    {
      "name": "editorconfig",
      "src": "scaffold",
      "dest": ".",
      "include": [
        ".editorconfig"
      ],
      "versioning": "no-clobber",
      "_comment": "Editor settings are universal, unlike the rest of scaffold/ which is project-shape-specific (compose files, hydra, CI). So this one file deploys unconditionally instead of waiting for --group scaffold. no-clobber: a project that already has an .editorconfig keeps it."
    },
    {
      "name": "scaffold",
      "src": "scaffold",
      "dest": ".",
      "include": [
        "**/*"
      ],
      "versioning": "no-clobber",
      "optional": true
    }
  ]
}
